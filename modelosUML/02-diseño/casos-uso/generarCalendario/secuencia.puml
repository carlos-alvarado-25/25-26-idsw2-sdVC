@startuml secuencia
skinparam backgroundColor white
skinparam shadowing false
skinparam DefaultFontColor black
skinparam DefaultFontSize 12
skinparam sequenceMessageAlign center

title Diseño Detallado: generarCalendario() (Desacoplado mediante CalendarioEngine)

actor Administrador as Actor
boundary GenerarCalendarioComponent <<Angular>>
control CalendarioApiService <<Angular>>
control CalendarioController <<NestJS>>
participant CalendarioService <<NestJS>>
participant CalendarioEngine <<Engine>>
participant "examen : Examen" as Examen <<Entity>>
participant "aula : Aula" as Aula <<Entity>>
participant "profesor : Profesor" as Profesor <<Entity>>
database ExamenRepository <<TypeORM>>
database AulaRepository <<TypeORM>>
database PreferenciaRepository <<TypeORM>>
database MySQL as DB

Actor -> GenerarCalendarioComponent : configurarParametros(fechaInicio, fechaFin, franjas)
activate GenerarCalendarioComponent
GenerarCalendarioComponent -> GenerarCalendarioComponent : validarFormulario()
Actor -> GenerarCalendarioComponent : clickGenerar()

GenerarCalendarioComponent -> CalendarioApiService : generarCalendario(dto)
activate CalendarioApiService

CalendarioApiService -> CalendarioController : POST /calendario/generar\n(GenerarCalendarioDto)
activate CalendarioController

CalendarioController -> CalendarioService : generar(dto)
activate CalendarioService

CalendarioService -> ExamenRepository : obtenerPendientes()
activate ExamenRepository
ExamenRepository -> DB : SELECT * FROM Examen WHERE fecha IS NULL
ExamenRepository --> CalendarioService : listaExamenesPendientes
deactivate ExamenRepository

CalendarioService -> ExamenRepository : obtenerExistentesEnRango(fechaInicio, fechaFin)
activate ExamenRepository
ExamenRepository -> DB : SELECT * FROM Examen WHERE fecha BETWEEN fechaInicio AND fechaFin
ExamenRepository --> CalendarioService : listaExamenesExistentes
deactivate ExamenRepository

CalendarioService -> AulaRepository : obtenerAulas()
activate AulaRepository
AulaRepository -> DB : SELECT * FROM Aula
AulaRepository --> CalendarioService : listaAulas
deactivate AulaRepository

CalendarioService -> PreferenciaRepository : obtenerPreferencias()
activate PreferenciaRepository
PreferenciaRepository -> DB : SELECT * FROM Preferencia
PreferenciaRepository --> CalendarioService : listaPreferencias
deactivate PreferenciaRepository

CalendarioService -> CalendarioEngine : generar(config)
activate CalendarioEngine

CalendarioEngine -> CalendarioEngine : generarRanurasTemporales()

loop Para cada Examen Pendiente
    CalendarioEngine -> CalendarioEngine : buscarSlotOptimo()
    
    loop Para cada Slot Temporal y Aula
        CalendarioEngine -> Aula : tieneCapacidadSuficiente(alumnos)
        activate Aula
        Aula --> CalendarioEngine : boolean
        deactivate Aula
        
        CalendarioEngine -> Aula : esTipoAdecuado(tipo)
        activate Aula
        Aula --> CalendarioEngine : boolean
        deactivate Aula
        
        CalendarioEngine -> Aula : estaDisponibleEn(fecha, franja, asignados)
        activate Aula
        Aula --> CalendarioEngine : boolean
        deactivate Aula
        
        loop Para cada Profesor Candidato (hasta encontrar uno disponible)
            CalendarioEngine -> Profesor : puedeImpartirAsignatura(asignaturaId)
            activate Profesor
            Profesor --> CalendarioEngine : boolean
            deactivate Profesor
            
            alt Profesor puede impartir la asignatura
                CalendarioEngine -> Profesor : estaDisponibleEn(fecha, franja, preferencias)
                activate Profesor
                Profesor --> CalendarioEngine : boolean
                deactivate Profesor
                
                CalendarioEngine -> Profesor : tieneCruceHorario(fecha, franja, asignados)
                activate Profesor
                Profesor --> CalendarioEngine : boolean
                deactivate Profesor
            end
        end
        
        alt Slot es Válido y Libre
            CalendarioEngine -> CalendarioEngine : registrarAsignacion(examen, slot, aula)
        end
    end
end

CalendarioEngine --> CalendarioService : generacionResultDto
deactivate CalendarioEngine

CalendarioService --> CalendarioController : generacionResultDto
deactivate CalendarioService

CalendarioController --> CalendarioApiService : 201 Created (GeneracionResultDto)
deactivate CalendarioController

CalendarioApiService --> GenerarCalendarioComponent : GeneracionResultDto
deactivate CalendarioApiService

GenerarCalendarioComponent -> GenerarCalendarioComponent : mostrarResultados(GeneracionResultDto)
deactivate GenerarCalendarioComponent

== Confirmación del Calendario por el Administrador ==

alt Confirmar y Guardar Calendario
    Actor -> GenerarCalendarioComponent : clickGuardar()
    activate GenerarCalendarioComponent
    
    GenerarCalendarioComponent -> CalendarioApiService : confirmarCalendario(confirmarDto)
    activate CalendarioApiService
    
    CalendarioApiService -> CalendarioController : POST /calendario/confirmar\n(ConfirmarCalendarioDto)
    activate CalendarioController
    
    CalendarioController -> CalendarioService : confirmar(dto)
    activate CalendarioService
    
    CalendarioService -> ExamenRepository : guardarLote(asignaciones)
    activate ExamenRepository
    ExamenRepository -> DB : UPDATE Examen SET fecha = ?, hora = ?, aulaId = ?, profesorId = ? WHERE id = ?
    ExamenRepository --> CalendarioService : confirmacion
    deactivate ExamenRepository
    
    CalendarioService --> CalendarioController : ok
    deactivate CalendarioService
    
    CalendarioController --> CalendarioApiService : 200 OK
    deactivate CalendarioController
    
    CalendarioApiService --> GenerarCalendarioComponent : ok
    deactivate CalendarioApiService
    
    GenerarCalendarioComponent -> GenerarCalendarioComponent : redireccionarAListado()
    GenerarCalendarioComponent --> Actor : mostrarMensajeExito("Calendario guardado correctamente")
    deactivate GenerarCalendarioComponent
else Cancelar y Descartar
    Actor -> GenerarCalendarioComponent : clickCancelar()
    activate GenerarCalendarioComponent
    GenerarCalendarioComponent -> GenerarCalendarioComponent : redireccionarAListado()
    deactivate GenerarCalendarioComponent
end

@enduml
